---
import Logo from './Logo.astro';
import WhatsAppButton from './WhatsAppButton.astro';
const links = [
  { href: '/', label: 'Beranda' },
  { href: '/katalog/', label: 'Katalog' },
  { href: '/#proses', label: 'Proses' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/#kontak', label: 'Kontak' },
];
---

<header class="site-nav">
  <div class="site-nav__inner">
    <Logo />
    <nav class="site-nav__links" aria-label="Navigasi utama">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="site-nav__actions">
      <WhatsAppButton label="Hubungi kami" size="nav" />
      <button class="site-nav__menu" type="button" aria-label="Buka menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="site-nav__mobile" aria-label="Navigasi mobile" hidden>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-nav__menu');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Buka menu' : 'Tutup menu');
    menu.hidden = open;
  });
</script>

<style>
  .site-nav { position: sticky; top: 0; z-index: 30; height: 80px; background: #fff; border-bottom: 1px solid var(--color-hairline); }
  .site-nav__inner { height: 100%; max-width: 1440px; margin: 0 auto; padding: 0 32px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .site-nav__links { display: flex; align-items: center; gap: 28px; height: 100%; }
  .site-nav__links a, .site-nav__mobile a { color: #6a6a6a; font-size: 16px; font-weight: 500; text-decoration: none; }
  .site-nav__links a:hover, .site-nav__mobile a:hover { color: #222; }
  .site-nav__links a[href='/'] { color: #222; }
  .site-nav__actions { display: flex; align-items: center; gap: 12px; }
  .site-nav__menu { display: none; width: 40px; height: 40px; border: 0; border-radius: 50%; background: var(--color-faint); align-items: center; justify-content: center; flex-direction: column; gap: 5px; }
  .site-nav__menu span { width: 15px; height: 1.5px; background: #222; }
  .site-nav__mobile { display: none; }
  @media (max-width: 800px) {
    .site-nav__inner { padding: 0 20px; }
    .site-nav__links, .site-nav__actions > :global(.wa-button) { display: none; }
    .site-nav__menu { display: flex; }
    .site-nav__mobile:not([hidden]) { position: absolute; top: 80px; left: 0; right: 0; display: grid; gap: 0; padding: 8px 20px 16px; background: white; border-bottom: 1px solid var(--color-hairline); }
    .site-nav__mobile a { min-height: 48px; display: flex; align-items: center; }
  }
  @media (prefers-reduced-motion: reduce) { .site-nav * { scroll-behavior: auto; } }
</style>

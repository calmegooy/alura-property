---
---

<section class="property-guide" id="proses" aria-labelledby="property-guide-title">
  <div class="property-guide__inner">
    <header class="property-guide__heading">
      <div>
        <p class="property-guide__eyebrow">Panduan survei</p>
        <h2 id="property-guide-title">Sebelum memilih, cek langsung</h2>
      </div>
      <p class="property-guide__intro">Pastikan lokasi, ukuran, harga, dan kelengkapan dokumen saat meninjau properti.</p>
    </header>

    <figure class="property-guide__visual">
      <img
        class="property-guide__image"
        src="/brand/landscape-background.webp"
        alt="Hamparan tanah hijau dengan kawasan permukiman di kejauhan"
        loading="lazy"
        width="1200"
        height="1500"
        data-parallax-image
      />
      <figcaption>Kawasan Yogyakarta & sekitarnya</figcaption>
    </figure>

    <div class="property-guide__columns">
      <section class="property-guide__group" aria-labelledby="property-details-title">
        <h3 class="property-guide__label" id="property-details-title">Hal yang perlu dicek</h3>
        <ul class="property-guide__list">
          <li>
            <h4>Lokasi & akses</h4>
            <p>Cocokkan titik lokasi dan perhatikan akses jalan serta lingkungan sekitar saat survei.</p>
          </li>
          <li>
            <h4>Ukuran & harga</h4>
            <p>Pastikan luas tanah atau bangunan serta skema harga—baik harga total, per m², maupun sewa tahunan.</p>
          </li>
          <li>
            <h4>Ketersediaan</h4>
            <p>Hubungi kami lewat WhatsApp sebelum berkunjung untuk memastikan unit masih tersedia.</p>
          </li>
          <li>
            <h4>Legalitas</h4>
            <p>Periksa kesesuaian sertifikat dan verifikasi dokumen bersama PPAT sebelum transaksi.</p>
          </li>
        </ul>
      </section>

      <section class="property-guide__group property-guide__steps" aria-labelledby="purchase-steps-title">
        <h3 class="property-guide__label" id="purchase-steps-title">Alur transaksi</h3>
        <ol class="property-guide__list">
          <li>
            <span class="property-guide__number">1</span>
            <div><h4>Pilih properti</h4><p>Tentukan area, luas, dan anggaran yang paling sesuai.</p></div>
          </li>
          <li>
            <span class="property-guide__number">2</span>
            <div><h4>Survei lokasi</h4><p>Tinjau langsung kondisi bangunan, batas lahan, dan akses jalan.</p></div>
          </li>
          <li>
            <span class="property-guide__number">3</span>
            <div><h4>Verifikasi dokumen</h4><p>Pastikan kelengkapan surat melalui PPAT sebelum pembayaran.</p></div>
          </li>
        </ol>
      </section>
    </div>
  </div>
</section>

<script>
  import { getParallaxOffset } from '../lib/scroll-story';

  const section = document.querySelector<HTMLElement>('.property-guide');
  const image = section?.querySelector<HTMLElement>('[data-parallax-image]');

  if (section && image && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let frame = 0;
    let visible = false;
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !frame) frame = requestAnimationFrame(update);
    });

    const update = () => {
      frame = 0;
      if (!visible) return;
      const bounds = section.getBoundingClientRect();
      const progress = (window.innerHeight - bounds.top) / (window.innerHeight + bounds.height);
      const amplitude = window.innerWidth <= 640 ? 8 : 16;
      const offset = getParallaxOffset(progress, amplitude);
      image.style.transform = `translate3d(0, ${offset}px, 0) scale(1.04)`;
    };

    const requestUpdate = () => {
      if (visible && !frame) frame = requestAnimationFrame(update);
    };

    observer.observe(section);
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
  }
</script>

<style>
  .property-guide {
    padding: 88px 24px 64px;
    background: transparent;
  }
  .property-guide__inner { max-width: 1200px; margin-inline: auto; }
  .property-guide__heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .55fr); align-items: end; gap: 32px; margin-bottom: 28px; }
  .property-guide__eyebrow { margin: 0 0 12px; color: #695c3d; font-size: 14px; font-weight: 500; }
  .property-guide__heading h2 { max-width: 700px; margin: 0; font-size: clamp(36px, 5vw, 58px); font-weight: 500; line-height: 1.04; text-wrap: balance; }
  .property-guide__intro { max-width: 380px; margin: 0 0 4px; color: #6a6a6a; font-size: 16px; line-height: 1.55; }
  .property-guide__visual { position: relative; height: clamp(280px, 38vw, 440px); margin: 0; overflow: hidden; border-radius: 28px; background: var(--color-faint); box-shadow: 0 16px 40px rgb(73 56 17 / 8%); }
  .property-guide__image { width: 100%; height: calc(100% + 32px); object-fit: cover; object-position: center 55%; transform: translate3d(0, 0, 0) scale(1.04); }
  .property-guide__visual figcaption {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 8px 14px;
    border: 1px solid rgb(255 255 255 / 78%);
    border-radius: 9999px;
    background: rgb(247 245 239 / 76%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    backdrop-filter: blur(14px) saturate(130%);
    box-shadow: 0 8px 24px rgb(34 34 34 / 12%);
    color: #493811;
    font-size: 12px;
    font-weight: 500;
  }
  .property-guide__columns {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, .85fr);
    gap: 24px;
    align-items: stretch;
    margin-top: -52px;
    padding-inline: 24px;
  }
  .property-guide__group {
    padding: 28px 30px;
    border: 1px solid rgb(255 255 255 / 92%);
    border-radius: 24px;
    background: linear-gradient(160deg, rgb(255 255 255 / 78%) 0%, rgb(247 245 239 / 64%) 100%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
    backdrop-filter: blur(18px) saturate(130%);
    box-shadow:
      0 12px 32px rgb(73 56 17 / 5%),
      0 0 0 1px rgb(73 56 17 / 6%),
      inset 0 1px 0 rgb(255 255 255 / 95%);
  }
  .property-guide__label { margin: 0 0 16px; color: #493811; font-size: 16px; font-weight: 600; }
  .property-guide__list { margin: 0; padding: 0; list-style: none; }
  .property-guide__list li { display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 20px; padding: 16px 0; border-top: 1px solid rgb(73 56 17 / 10%); }
  .property-guide__list h4 { margin: 0; font-size: 15px; font-weight: 600; line-height: 1.4; color: #222; }
  .property-guide__list p { max-width: 560px; margin: 0; color: #6a6a6a; font-size: 14px; line-height: 1.55; }
  .property-guide__steps .property-guide__list li { grid-template-columns: 34px minmax(0, 1fr); gap: 14px; align-items: start; }
  .property-guide__steps .property-guide__list h4 { margin-bottom: 3px; }
  .property-guide__number {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid rgb(73 56 17 / 14%);
    border-radius: 50%;
    background: rgb(73 56 17 / 8%);
    color: #493811;
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 760px) {
    .property-guide { padding: 64px 20px 48px; }
    .property-guide__heading { grid-template-columns: 1fr; gap: 16px; margin-bottom: 24px; }
    .property-guide__heading h2 { max-width: 560px; font-size: clamp(34px, 9vw, 46px); }
    .property-guide__intro { max-width: 480px; }
    .property-guide__visual { height: clamp(240px, 62vw, 360px); border-radius: 24px; }
    .property-guide__visual figcaption { top: 12px; right: 12px; bottom: auto; }
    .property-guide__columns { grid-template-columns: 1fr; gap: 18px; margin-top: -28px; padding-inline: 12px; }
    .property-guide__group { padding: 22px 20px; border-radius: 20px; }
    .property-guide__label { margin-bottom: 12px; }
    .property-guide__list li { grid-template-columns: 108px minmax(0, 1fr); gap: 12px; padding: 14px 0; }
    .property-guide__steps .property-guide__list li { grid-template-columns: 32px minmax(0, 1fr); }
  }
  @media (max-width: 380px) {
    .property-guide__list li { grid-template-columns: 92px minmax(0, 1fr); gap: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .property-guide__image { transform: none !important; }
  }
</style>

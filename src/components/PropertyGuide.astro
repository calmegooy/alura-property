---
---

<section class="property-guide" id="proses" aria-labelledby="property-guide-title">
  <div class="property-guide__inner">
    <header class="property-guide__heading">
      <div>
        <p class="property-guide__eyebrow">Sebelum survei</p>
        <h2 id="property-guide-title">Sebelum memilih, cek langsung</h2>
      </div>
      <p class="property-guide__intro">Pastikan lokasi, harga, ketersediaan, dan dokumen saat meninjau tanah.</p>
    </header>

    <figure class="property-guide__visual">
      <img
        class="property-guide__image"
        src="/brand/landscape-background.webp"
        alt="Hamparan tanah hijau dengan kawasan permukiman di kejauhan"
        loading="lazy"
        width="1200"
        height="1500"
        data-parallax-image
      />
      <figcaption>Ilustrasi kawasan</figcaption>
    </figure>

    <div class="property-guide__columns">
      <section class="property-guide__group" aria-labelledby="property-details-title">
        <h3 class="property-guide__label" id="property-details-title">Periksa bidang</h3>
        <ul class="property-guide__list">
          <li>
            <h4>Lokasi</h4>
            <p>Cocokkan alamat dan titik peta, lalu perhatikan akses jalan saat berkunjung.</p>
          </li>
          <li>
            <h4>Luas dan harga</h4>
            <p>Pastikan ukuran bidang dan harga total; hitung harga per meter sebagai pembanding.</p>
          </li>
          <li>
            <h4>Status</h4>
            <p>Hubungi admin sebelum survei untuk memastikan tanah masih tersedia.</p>
          </li>
          <li>
            <h4>Dokumen</h4>
            <p>Cocokkan data bidang dengan sertifikat dan minta PPAT memeriksanya.</p>
          </li>
        </ul>
      </section>

      <section class="property-guide__group property-guide__steps" aria-labelledby="purchase-steps-title">
        <h3 class="property-guide__label" id="purchase-steps-title">Langkah pembelian</h3>
        <ol class="property-guide__list">
          <li>
            <span class="property-guide__number">1</span>
            <div><h4>Pilih</h4><p>Tentukan lokasi dan kisaran harga yang sesuai.</p></div>
          </li>
          <li>
            <span class="property-guide__number">2</span>
            <div><h4>Survei</h4><p>Cek batas, akses, dan kondisi sekitar langsung di lokasi.</p></div>
          </li>
          <li>
            <span class="property-guide__number">3</span>
            <div><h4>Verifikasi</h4><p>Pastikan dokumen diperiksa sebelum pembayaran.</p></div>
          </li>
        </ol>
      </section>
    </div>
  </div>
</section>

<script>
  import { getParallaxOffset } from '../lib/scroll-story';

  const section = document.querySelector<HTMLElement>('.property-guide');
  const image = section?.querySelector<HTMLElement>('[data-parallax-image]');

  if (section && image && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let frame = 0;
    let visible = false;
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !frame) frame = requestAnimationFrame(update);
    });

    const update = () => {
      frame = 0;
      if (!visible) return;
      const bounds = section.getBoundingClientRect();
      const progress = (window.innerHeight - bounds.top) / (window.innerHeight + bounds.height);
      const amplitude = window.innerWidth <= 640 ? 8 : 16;
      const offset = getParallaxOffset(progress, amplitude);
      image.style.transform = `translate3d(0, ${offset}px, 0) scale(1.04)`;
    };

    const requestUpdate = () => {
      if (visible && !frame) frame = requestAnimationFrame(update);
    };

    observer.observe(section);
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
  }
</script>

<style>
  .property-guide { padding: 88px 24px 64px; }
  .property-guide__inner { max-width: 1200px; margin-inline: auto; }
  .property-guide__heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .55fr); align-items: end; gap: 32px; margin-bottom: 28px; }
  .property-guide__eyebrow { margin: 0 0 12px; color: #695c3d; font-size: 14px; font-weight: 500; }
  .property-guide__heading h2 { max-width: 700px; margin: 0; font-size: clamp(36px, 5vw, 58px); font-weight: 500; line-height: 1.04; text-wrap: balance; }
  .property-guide__intro { max-width: 380px; margin: 0 0 4px; color: #625d51; font-size: 16px; line-height: 1.55; }
  .property-guide__visual { position: relative; height: clamp(280px, 38vw, 440px); margin: 0 0 52px; overflow: hidden; border-radius: 28px; background: #e8e2d3; }
  .property-guide__image { width: 100%; height: calc(100% + 32px); object-fit: cover; object-position: center 55%; transform: translate3d(0, 0, 0) scale(1.04); }
  .property-guide__visual figcaption { position: absolute; right: 20px; bottom: 20px; padding: 8px 12px; border-radius: 8px; background: rgb(247 245 239 / 94%); color: #493811; font-size: 12px; }
  .property-guide__columns { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr); gap: 72px; }
  .property-guide__label { margin: 0 0 16px; color: #493811; font-size: 16px; font-weight: 600; }
  .property-guide__list { margin: 0; padding: 0; list-style: none; }
  .property-guide__list li { display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 20px; padding: 16px 0; border-top: 1px solid #dedbd2; }
  .property-guide__list h4 { margin: 0; font-size: 16px; font-weight: 500; line-height: 1.4; }
  .property-guide__list p { max-width: 560px; margin: 0; color: #625d51; font-size: 14px; line-height: 1.55; }
  .property-guide__steps .property-guide__list li { grid-template-columns: 28px minmax(0, 1fr); gap: 12px; }
  .property-guide__steps .property-guide__list h4 { margin-bottom: 2px; }
  .property-guide__number { color: #695c3d; font-size: 14px; font-variant-numeric: tabular-nums; }
  @media (max-width: 760px) {
    .property-guide { padding: 64px 20px 48px; }
    .property-guide__heading { grid-template-columns: 1fr; gap: 16px; margin-bottom: 24px; }
    .property-guide__heading h2 { max-width: 560px; font-size: clamp(34px, 9vw, 46px); }
    .property-guide__intro { max-width: 480px; }
    .property-guide__visual { height: clamp(240px, 62vw, 360px); margin-bottom: 36px; border-radius: 24px; }
    .property-guide__visual figcaption { right: 12px; bottom: 12px; }
    .property-guide__columns { grid-template-columns: 1fr; gap: 36px; }
    .property-guide__label { margin-bottom: 12px; }
    .property-guide__list li { grid-template-columns: 104px minmax(0, 1fr); gap: 12px; padding: 14px 0; }
    .property-guide__steps .property-guide__list li { grid-template-columns: 24px minmax(0, 1fr); }
  }
  @media (max-width: 380px) {
    .property-guide__list li { grid-template-columns: 88px minmax(0, 1fr); gap: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .property-guide__image { transform: none !important; }
  }
</style>

---
import type { Land } from '../data/lands';
import { buildWhatsAppLink } from '../lib/whatsapp';
interface Props {
  land?: Land;
  label?: string;
  class?: string;
  size?: 'default' | 'nav' | 'editorial' | 'compact' | 'inverse';
}
const { land, label = 'Chat WhatsApp', class: className = '', size = 'default' } = Astro.props;
const href = buildWhatsAppLink(land);
const sizeClass = size === 'default' ? '' : `wa-button--${size}`;
---

{href ? (
  <a class:list={['wa-button', sizeClass, className]} href={href} target="_blank" rel="noopener noreferrer">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none">
      <path d="M20 11.6a8 8 0 0 1-11.8 7l-4.2 1.1 1.1-4.1a8 8 0 1 1 14.9-4Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M9 8.2c.3-.6.6-.6.9-.6h.4c.2 0 .4.1.5.4l.7 1.7c.1.2.1.4-.1.6l-.5.6c-.2.2-.2.4 0 .6.5.8 1.2 1.4 2 1.8.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.7-.1l1.5.7c.3.1.4.3.4.5 0 .3-.2 1-.7 1.3-.5.4-1.1.5-1.8.3-.8-.2-1.8-.7-2.8-1.6-1.2-1-2-2.2-2.3-3.2-.3-.8 0-1.6.4-2.1Z" fill="currentColor" />
    </svg>
    <span>{label}</span>
  </a>
) : (
  <span class:list={['wa-button', 'wa-button--disabled', sizeClass, className]} aria-label="Nomor WhatsApp belum dikonfigurasi" aria-disabled="true">
    {label}
  </span>
)}

<style>
  .wa-button { box-sizing: border-box; display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 20px; border: 0; border-radius: 9999px; background: var(--color-accent); color: white; font-size: 14px; font-weight: 500; line-height: 1; text-align: center; text-decoration: none; white-space: nowrap; transition: filter 150ms ease-out; }
  .wa-button svg { flex: 0 0 18px; }
  .wa-button--nav { min-height: 40px; padding-inline: 16px; }
  .wa-button--editorial { min-height: 56px; padding-inline: 32px; font-size: 16px; }
  .wa-button--compact { min-height: 40px; padding-inline: 16px; }
  .wa-button--inverse { background: #f7f5ef; color: #493811; }
  .wa-button--disabled { background: #e9e5db; color: #625d51; opacity: 1; cursor: not-allowed; }
  @media (hover: hover) and (pointer: fine) { .wa-button:hover { filter: brightness(.92); } }
  @media (prefers-reduced-motion: reduce) { .wa-button { transition: none; } }
</style>

---
import { SITE_NAME } from '../config/site';
import { buildWhatsAppLink } from '../lib/whatsapp';
import WhatsAppButton from './WhatsAppButton.astro';
const generalWhatsAppHref = buildWhatsAppLink();
---

<footer class="site-footer">
  <div class="site-footer__wrap">
    <div class="site-footer__content">
      <section class="site-footer__contact" id="kontak" aria-labelledby="footer-contact-title">
        <div>
          <h2 id="footer-contact-title">Ada properti yang ingin disurvei?</h2>
          <p>Hubungi kami lewat WhatsApp untuk menanyakan detail, ketersediaan, atau jadwal survei lokasi.</p>
        </div>
        <WhatsAppButton label="Hubungi Kami" size="editorial" />
      </section>

      <div class="site-footer__columns">
        <section><h3>Jelajahi</h3><a href="/katalog/">Semua properti</a><a href="/katalog/?kategori=tanah">Tanah</a><a href="/katalog/?kategori=rumah">Rumah</a><a href="/katalog/?kategori=komersial">Komersial</a></section>
        <section><h3>Informasi</h3><a href="/#proses">Panduan survei</a><a href="/#faq">Pertanyaan umum</a></section>
        <section><h3>Kontak</h3><a href={generalWhatsAppHref || '/#kontak'} target={generalWhatsAppHref ? '_blank' : undefined} rel={generalWhatsAppHref ? 'noopener noreferrer' : undefined}>WhatsApp (+62 812-2586-867)</a><a href="/katalog/?transaksi=sewa">Properti disewakan</a></section>
      </div>

      <div class="site-footer__bottom">
        <p>© {new Date().getFullYear()} {SITE_NAME}. Yogyakarta & sekitarnya.</p>
      </div>
    </div>
  </div>
  <div class="site-footer__visual" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-top: 24px;
    background: var(--color-faint);
  }
  .site-footer__wrap { position: relative; z-index: 2; padding: 0 24px; }
  .site-footer__content {
    box-sizing: border-box;
    max-width: 1220px;
    margin-inline: auto;
    padding: 36px 36px 28px;
    border: 1px solid rgb(255 255 255 / 92%);
    border-radius: 28px;
    background: linear-gradient(160deg, rgb(255 255 255 / 78%) 0%, rgb(247 245 239 / 64%) 100%);
    -webkit-backdrop-filter: blur(22px) saturate(130%);
    backdrop-filter: blur(22px) saturate(130%);
    box-shadow:
      0 18px 46px rgb(73 56 17 / 6%),
      0 0 0 1px rgb(73 56 17 / 6%),
      inset 0 1px 0 rgb(255 255 255 / 95%);
  }
  .site-footer__contact { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding-bottom: 28px; border-bottom: 1px solid rgb(73 56 17 / 10%); }
  .site-footer__contact h2 { margin: 0 0 8px; color: #222; font-size: clamp(26px, 3.6vw, 34px); font-weight: 500; line-height: 1.15; }
  .site-footer__contact p { margin: 0; color: #6a6a6a; line-height: 1.55; }
  .site-footer__columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; padding: 28px 0; }
  .site-footer__columns section { display: grid; align-content: start; gap: 11px; }
  .site-footer__columns h3 { margin: 0 0 4px; color: #493811; font-size: 14px; font-weight: 600; }
  .site-footer a { width: fit-content; color: #6a6a6a; font-size: 14px; text-decoration: none; transition: color 150ms ease; }
  .site-footer a:hover { color: #222; }
  .site-footer__bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; border-top: 1px solid rgb(73 56 17 / 10%); padding-top: 18px; }
  .site-footer__bottom p { margin: 0; color: #6a6a6a; font-size: 13px; }
  .site-footer__visual {
    position: relative;
    z-index: 1;
    height: clamp(360px, 40vw, 660px);
    margin-top: -190px;
    background:
      linear-gradient(
        to bottom,
        #f7f5ef 0%,
        #f7f5ef 14%,
        rgb(247 245 239 / 90%) 32%,
        rgb(247 245 239 / 64%) 52%,
        rgb(247 245 239 / 28%) 74%,
        rgb(247 245 239 / 0%) 92%
      ),
      url('/brand/housing-development.webp') center 52% / cover no-repeat;
  }
  @media (max-width: 820px) {
    .site-footer__contact { align-items: flex-start; flex-direction: column; gap: 20px; padding-bottom: 22px; }
  }
  @media (max-width: 640px) {
    .site-footer__wrap { padding: 0 16px; }
    .site-footer__content { padding: 24px 20px; border-radius: 22px; }
    .site-footer__columns { grid-template-columns: 1fr 1fr; gap: 24px 16px; padding: 22px 0; }
    .site-footer__columns section { min-width: 0; gap: 10px; }
    .site-footer a { overflow-wrap: anywhere; }
    .site-footer__bottom { align-items: flex-start; flex-direction: column; }
    .site-footer__visual { height: 260px; margin-top: -110px; background-position: center, 62% center; }
  }
  @media (max-width: 420px) {
    .site-footer__columns { grid-template-columns: 1fr; gap: 20px; }
  }
</style>

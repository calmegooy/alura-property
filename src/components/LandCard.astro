---
import type { Land } from '../data/lands';
import { formatArea, formatLandPrice, formatLocation } from '../lib/format';
import WhatsAppButton from './WhatsAppButton.astro';
interface Props { land: Land }
const { land } = Astro.props;
const location = formatLocation(land.lokasi, 'short');
const price = formatLandPrice(land);
const transaksi = land.transaksi ?? 'jual';
const badgeLabel =
  land.status === 'terjual'
    ? 'Terjual'
    : land.status === 'dipesan'
      ? 'Dipesan'
      : transaksi === 'sewa'
        ? 'Disewakan'
        : 'Tersedia';
const metaParts = land.ringkasan_kartu
  ? [location, land.ringkasan_kartu]
  : [
      location,
      typeof land.luas_m2 === 'number' ? formatArea(land.luas_m2) : '',
      land.legalitas !== 'Perlu konfirmasi' ? land.legalitas : '',
    ].filter(Boolean);
const searchIndex =
  `${land.nama} ${formatLocation(land.lokasi, 'full')}`.toLocaleLowerCase('id-ID');
---

<article
  class:list={['land-card', land.status === 'terjual' && 'land-card--sold']}
  data-kategori={land.kategori}
  data-transaksi={transaksi}
  data-luas={land.luas_m2 ?? ''}
  data-harga={land.harga_total ?? land.harga_per_m2 ?? ''}
  data-created={land.created_at}
  data-search={searchIndex}
>
  <a class="land-card__link" href={`/katalog/${land.slug}/`} aria-label={`Lihat detail ${land.nama}`}>
    <div class="land-card__image">
      <img
        src={land.foto_utama}
        alt={land.contoh ? `Contoh foto ${land.nama}` : `Foto ${land.nama}`}
        loading="lazy"
        width="800"
        height="800"
      />
      <span class="land-card__badge">{badgeLabel}</span>
      {land.contoh && <span class="land-card__sample">Contoh</span>}
    </div>
    <div class="land-card__details">
      <h3>{land.nama}</h3>
      <p class="land-card__meta">{metaParts.join(' · ')}</p>
      <p class="land-card__price">
        <strong>{price.primary}</strong>
        {typeof land.harga_total === 'number' && price.secondary && <span> · {price.secondary}</span>}
      </p>
    </div>
  </a>
  {land.status === 'terjual' ? (
    <p class="land-card__sold">Terjual</p>
  ) : (
    <div class="land-card__actions">
      <WhatsAppButton land={land} label="Chat WhatsApp" size="compact" class="land-card__wa" />
    </div>
  )}
</article>

<style>
  .land-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    padding: 12px 12px 14px;
    border: 1px solid rgb(255 255 255 / 92%);
    border-radius: 20px;
    background: linear-gradient(160deg, rgb(255 255 255 / 78%) 0%, rgb(247 245 239 / 64%) 100%);
    -webkit-backdrop-filter: blur(16px) saturate(130%);
    backdrop-filter: blur(16px) saturate(130%);
    box-shadow:
      0 10px 28px rgb(73 56 17 / 5%),
      0 0 0 1px rgb(73 56 17 / 6%),
      inset 0 1px 0 rgb(255 255 255 / 95%);
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
  }
  .land-card:hover {
    transform: translateY(-2px);
    border-color: rgb(73 56 17 / 14%);
    box-shadow:
      0 16px 36px rgb(73 56 17 / 8%),
      0 0 0 1px rgb(73 56 17 / 10%),
      inset 0 1px 0 #fff;
  }
  .land-card__link { display: flex; flex: 1 1 auto; flex-direction: column; color: inherit; text-decoration: none; }
  .land-card__image { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 14px; background: var(--color-faint); }
  .land-card__image img { width: 100%; height: 100%; object-fit: cover; transition: transform 320ms ease; }
  .land-card:hover .land-card__image img { transform: scale(1.03); }
  .land-card--sold img { filter: grayscale(.45); }
  .land-card__badge, .land-card__sample {
    position: absolute;
    top: 10px;
    padding: 5px 11px;
    border: 1px solid rgb(255 255 255 / 80%);
    border-radius: 9999px;
    background: rgb(247 245 239 / 82%);
    -webkit-backdrop-filter: blur(12px) saturate(130%);
    backdrop-filter: blur(12px) saturate(130%);
    box-shadow: 0 4px 12px rgb(34 34 34 / 10%);
    color: #493811;
    font-size: 12px;
    font-weight: 600;
  }
  .land-card__badge { left: 10px; }
  .land-card__sample { right: 10px; }
  .land-card__details { display: flex; flex: 1 1 auto; flex-direction: column; padding: 0 2px; }
  .land-card__details h3 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 12px 0 4px;
    color: #222;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
  }
  .land-card__details p { margin: 0; color: #6a6a6a; font-size: 13.5px; line-height: 1.45; }
  .land-card__meta { margin-bottom: 10px !important; }
  .land-card__price { margin-top: auto !important; padding-top: 8px; border-top: 1px solid rgb(73 56 17 / 8%); overflow-wrap: anywhere; }
  .land-card__price strong { color: #222; font-size: 14.5px; font-weight: 600; }
  .land-card__sold { margin: 12px 0 0; color: #6a6a6a; font-size: 14px; font-weight: 600; }
  .land-card__actions { margin-top: 12px; }
  .land-card__actions :global(.wa-button) { width: 100%; padding-inline: 12px; font-size: 13px; }
  @media (max-width: 520px) {
    .land-card { padding: 9px 9px 11px; border-radius: 16px; }
    .land-card__image { border-radius: 11px; }
    .land-card__badge, .land-card__sample { top: 8px; padding: 4px 9px; font-size: 11px; }
    .land-card__badge { left: 8px; }
    .land-card__sample { right: 8px; }
    .land-card__details h3 { margin: 9px 0 3px; font-size: 13.5px; }
    .land-card__details p { font-size: 12.5px; }
    .land-card__price strong { font-size: 13.5px; }
    .land-card__actions { margin-top: 10px; }
    .land-card__actions :global(.wa-button) { min-height: 36px; padding-inline: 10px; font-size: 12px; gap: 6px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .land-card, .land-card__image img { transition: none; }
    .land-card:hover { transform: none; }
    .land-card:hover .land-card__image img { transform: none; }
  }
</style>

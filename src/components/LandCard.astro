---
import type { Land } from '../data/lands';
import { formatRupiah } from '../lib/format';
import WhatsAppButton from './WhatsAppButton.astro';
interface Props { land: Land }
const { land } = Astro.props;
const location = `${land.lokasi.kecamatan}, ${land.lokasi.kota}`;
---

<article class:list={['land-card', land.status === 'terjual' && 'land-card--sold']}>
  <a class="land-card__link" href={`/katalog/${land.slug}/`} aria-label={`Lihat detail ${land.nama}`}>
    <div class="land-card__image">
      <img src={land.foto_utama} alt={`Contoh foto ${land.nama}`} loading="lazy" width="800" height="800" />
      <span class="land-card__badge">{land.status === 'terjual' ? 'Terjual' : land.status === 'dipesan' ? 'Dipesan' : land.created_at === '2026-11-14' ? 'Baru' : 'Tersedia'}</span>
      {land.contoh && <span class="land-card__sample">Contoh</span>}
    </div>
    <div class="land-card__details">
      <h3>{land.nama}</h3>
      <p>{location} · {land.luas_m2.toLocaleString('id-ID')} m² · {land.legalitas}</p>
      <p class="land-card__price"><strong>{formatRupiah(land.harga_total)}</strong><span> · {formatRupiah(land.harga_per_m2)}/m²</span></p>
    </div>
  </a>
  {land.status === 'terjual' ? <p class="land-card__sold">Terjual</p> : <div class="land-card__actions"><WhatsAppButton land={land} label="Chat WhatsApp" size="compact" class="land-card__wa" /></div>}
</article>

<style>
  .land-card { min-width: 0; }
  .land-card__link { display: block; color: inherit; text-decoration: none; }
  .land-card__image { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 12px; background: #ebebeb; }
  .land-card__image img { width: 100%; height: 100%; object-fit: cover; }
  .land-card--sold img { filter: grayscale(.45); }
  .land-card__badge, .land-card__sample { position: absolute; top: 12px; padding: 6px 12px; border-radius: 9999px; background: white; box-shadow: 0 2px 6px rgb(0 0 0 / 12%); color: #222; font-size: 12px; font-weight: 600; }
  .land-card__badge { left: 12px; }
  .land-card__sample { right: 12px; }
  .land-card__details h3 { overflow: hidden; margin: 12px 0 4px; font-size: 14px; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
  .land-card__details p { margin: 0; color: #6a6a6a; font-size: 14px; line-height: 1.45; }
  .land-card__price { margin-top: 4px !important; }
  .land-card__price strong { color: #222; font-weight: 600; }
  .land-card__sold { margin: 10px 0 0; font-size: 14px; font-weight: 600; }
  .land-card__actions { margin-top: 16px; }
  .land-card__actions :global(.wa-button) { width: 100%; padding-inline: 8px; font-size: 13px; }
</style>

---
import type { Land } from '../data/lands';
import LandCard from './LandCard.astro';
import { filterLands, sortLands } from '../lib/catalog';
interface Props { lands: Land[] }
const { lands } = Astro.props;
const tabs = [
  { key: 'semua', param: 'kategori', value: 'semua', label: 'Semua', href: '/katalog/' },
  { key: 'tanah', param: 'kategori', value: 'tanah', label: 'Tanah', href: '/katalog/?kategori=tanah' },
  { key: 'rumah', param: 'kategori', value: 'rumah', label: 'Rumah', href: '/katalog/?kategori=rumah' },
  { key: 'komersial', param: 'kategori', value: 'komersial', label: 'Komersial', href: '/katalog/?kategori=komersial' },
  { key: 'sewa', param: 'transaksi', value: 'sewa', label: 'Disewakan', href: '/katalog/?transaksi=sewa' },
] as const;
const sorted = sortLands(filterLands(lands), 'terbaru');
---

<section class="catalog" aria-labelledby="catalog-title">
  <header class="catalog__intro">
    <p class="catalog__eyebrow">Alura Property · Yogyakarta & sekitarnya</p>
    <h1 id="catalog-title">Katalog properti</h1>
    <p class="catalog__subtitle">Telusuri pilihan tanah, rumah, dan properti komersial berdasarkan area, luas, maupun jenis transaksi.</p>
  </header>

  <div class="catalog__filter">
    <form action="/katalog/" method="get" data-catalog-form>
      <label>Lokasi atau nama<input name="q" type="search" placeholder="Cari Sleman, Bantul, Kota..." /></label>
      <label>Luas<select name="luas"><option value="">Semua luas</option><option value="small">Di bawah 500 m²</option><option value="large">500 m² ke atas</option></select></label>
      <label>Urutkan<select name="urut"><option value="terbaru">Terbaru</option><option value="harga-rendah">Harga terendah</option><option value="harga-tinggi">Harga tertinggi</option><option value="luas">Luas terbesar</option></select></label>
      <button type="submit" aria-label="Cari properti"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.8"/><path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
    </form>
  </div>
  <nav class="catalog__tabs" aria-label="Kategori properti">
    {tabs.map((tab) => (
      <a
        class:list={{ active: tab.key === 'semua' }}
        href={tab.href}
        data-tab-param={tab.param}
        data-tab-value={tab.value}
      >
        {tab.label}
      </a>
    ))}
  </nav>
  <div class="catalog__heading">
    <p class="catalog__count" data-catalog-count>{sorted.length} properti tersedia</p>
    <label>
      <span>Urutkan</span>
      <select data-catalog-sort-mirror>
        <option value="terbaru">Terbaru</option>
        <option value="harga-rendah">Harga terendah</option>
        <option value="harga-tinggi">Harga tertinggi</option>
        <option value="luas">Luas terbesar</option>
      </select>
    </label>
  </div>
  <div class="catalog__grid" data-catalog-grid>
    {sorted.map((land) => <LandCard land={land} />)}
  </div>
  <div class="catalog__empty" data-catalog-empty hidden={sorted.length > 0}>
    <p>Belum ada properti yang sesuai dengan filter pencarian Anda.</p>
    <a href="/katalog/">Tampilkan semua properti</a>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-catalog-form]');
  const grid = document.querySelector<HTMLElement>('[data-catalog-grid]');
  const empty = document.querySelector<HTMLElement>('[data-catalog-empty]');
  const countLabel = document.querySelector<HTMLElement>('[data-catalog-count]');
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('.catalog__tabs a')];
  const sortMirror = document.querySelector<HTMLSelectElement>('[data-catalog-sort-mirror]');

  if (form && grid) {
    const qInput = form.querySelector<HTMLInputElement>('input[name="q"]');
    const luasSelect = form.querySelector<HTMLSelectElement>('select[name="luas"]');
    const sortSelect = form.querySelector<HTMLSelectElement>('select[name="urut"]');
    const cards = [...grid.querySelectorAll<HTMLElement>('.land-card')];

    const applyFilters = () => {
      const params = new URLSearchParams(window.location.search);
      const kategori = params.get('kategori') || 'semua';
      const transaksi = params.get('transaksi') || 'semua';
      const q = (params.get('q') || '').trim().toLocaleLowerCase('id-ID');
      const luas = params.get('luas') || '';
      const urut = params.get('urut') || 'terbaru';

      if (qInput) qInput.value = params.get('q') || '';
      if (luasSelect) luasSelect.value = luas;
      if (sortSelect) sortSelect.value = urut;
      if (sortMirror) sortMirror.value = urut;

      tabs.forEach((tab) => {
        const param = tab.dataset.tabParam;
        const val = tab.dataset.tabValue;
        const isActive =
          param === 'transaksi'
            ? transaksi === val
            : transaksi === 'semua' && kategori === val;
        tab.classList.toggle('active', isActive);
      });

      const visibleCards: HTMLElement[] = [];
      cards.forEach((card) => {
        const cardKategori = card.dataset.kategori || '';
        const cardTransaksi = card.dataset.transaksi || 'jual';
        const cardSearch = card.dataset.search || '';
        const rawLuas = card.dataset.luas;
        const cardLuas = rawLuas ? Number(rawLuas) : null;

        const matchKategori = kategori === 'semua' || cardKategori === kategori;
        const matchTransaksi = transaksi === 'semua' || cardTransaksi === transaksi;
        const matchQuery = !q || cardSearch.includes(q);
        const matchLuas =
          !luas ||
          (cardLuas !== null && (luas === 'small' ? cardLuas < 500 : cardLuas >= 500));

        const show = matchKategori && matchTransaksi && matchQuery && matchLuas;
        card.hidden = !show;
        if (show) visibleCards.push(card);
      });

      const numOr = (val: string | undefined, fallback: number) =>
        val ? Number(val) : fallback;

      visibleCards.sort((a, b) => {
        switch (urut) {
          case 'harga-rendah':
            return numOr(a.dataset.harga, Number.POSITIVE_INFINITY) - numOr(b.dataset.harga, Number.POSITIVE_INFINITY);
          case 'harga-tinggi':
            return numOr(b.dataset.harga, 0) - numOr(a.dataset.harga, 0);
          case 'luas':
            return numOr(b.dataset.luas, 0) - numOr(a.dataset.luas, 0);
          case 'terbaru':
          default:
            return (b.dataset.created || '').localeCompare(a.dataset.created || '');
        }
      });

      visibleCards.forEach((card) => grid.appendChild(card));
      if (countLabel) {
        countLabel.textContent = visibleCards.length > 0
          ? `${visibleCards.length} properti tersedia`
          : 'Tidak ada properti yang sesuai';
      }
      if (empty) empty.hidden = visibleCards.length > 0;
    };

    const updateParamAndRun = (updates: Record<string, string>) => {
      const params = new URLSearchParams(window.location.search);
      Object.entries(updates).forEach(([key, val]) => {
        if (val && val !== 'semua') params.set(key, val);
        else params.delete(key);
      });
      const query = params.toString();
      history.replaceState(null, '', query ? `?${query}` : window.location.pathname);
      applyFilters();
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      updateParamAndRun({
        q: qInput?.value.trim() || '',
        luas: luasSelect?.value || '',
        urut: sortSelect?.value || 'terbaru',
      });
    });

    luasSelect?.addEventListener('change', () => {
      updateParamAndRun({ luas: luasSelect.value });
    });

    sortSelect?.addEventListener('change', () => {
      updateParamAndRun({ urut: sortSelect.value });
    });

    sortMirror?.addEventListener('change', () => {
      updateParamAndRun({ urut: sortMirror.value });
    });

    tabs.forEach((tab) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        const param = tab.dataset.tabParam;
        const val = tab.dataset.tabValue || 'semua';
        if (param === 'transaksi') {
          updateParamAndRun({ transaksi: val, kategori: '' });
        } else {
          updateParamAndRun({ kategori: val, transaksi: '' });
        }
      });
    });

    applyFilters();
  }
</script>

<style>
  .catalog { max-width: 1280px; margin: 0 auto; padding: 40px 24px 80px; }
  .catalog__intro { max-width: 720px; margin: 0 auto 28px; text-align: center; }
  .catalog__eyebrow { margin: 0 0 10px; color: #695c3d; font-size: 13px; font-weight: 500; }
  .catalog__intro h1 { margin: 0 0 10px; color: #222; font-size: clamp(32px, 4.4vw, 46px); font-weight: 500; line-height: 1.1; text-wrap: balance; }
  .catalog__subtitle { margin: 0; color: #6a6a6a; font-size: 15px; line-height: 1.55; }

  .catalog__filter {
    max-width: 880px;
    margin: 0 auto 24px;
    padding: 8px 10px 8px 22px;
    border: 1px solid rgb(255 255 255 / 92%);
    border-radius: 9999px;
    background: linear-gradient(160deg, rgb(255 255 255 / 80%) 0%, rgb(247 245 239 / 68%) 100%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
    backdrop-filter: blur(18px) saturate(130%);
    box-shadow:
      0 12px 32px rgb(73 56 17 / 5%),
      0 0 0 1px rgb(73 56 17 / 6%),
      inset 0 1px 0 rgb(255 255 255 / 95%);
  }
  .catalog__filter form { display: grid; grid-template-columns: 1.2fr .95fr .95fr 46px; align-items: center; }
  .catalog__filter label { display: grid; gap: 3px; padding: 6px 18px; border-right: 1px solid rgb(73 56 17 / 10%); color: #493811; font-size: 13px; font-weight: 600; }
  .catalog__filter label:nth-of-type(3) { border-right: 0; }
  .catalog__filter input, .catalog__filter select { min-width: 0; border: 0; background: transparent; color: #222; font: inherit; font-size: 14px; font-weight: 400; outline: none; }
  .catalog__filter input::placeholder { color: #6a6a6a; }
  .catalog__filter button { display: grid; place-items: center; width: 46px; height: 46px; padding: 0; border: 0; border-radius: 50%; background: var(--color-accent); color: #fff; line-height: 0; cursor: pointer; transition: background 150ms ease; }
  .catalog__filter button:hover { background: var(--color-accent-hover); }
  .catalog__filter button svg { display: block; }

  .catalog__tabs { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .catalog__tabs a {
    flex: 0 0 auto;
    padding: 9px 18px;
    border: 1px solid rgb(255 255 255 / 88%);
    border-radius: 9999px;
    background: linear-gradient(160deg, rgb(255 255 255 / 72%) 0%, rgb(247 245 239 / 58%) 100%);
    -webkit-backdrop-filter: blur(12px) saturate(130%);
    backdrop-filter: blur(12px) saturate(130%);
    box-shadow: 0 4px 12px rgb(73 56 17 / 4%), 0 0 0 1px rgb(73 56 17 / 6%);
    color: #575246;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .catalog__tabs a:hover { color: #222; border-color: rgb(73 56 17 / 16%); }
  .catalog__tabs a.active { background: var(--color-accent); border-color: var(--color-accent); box-shadow: 0 6px 16px rgb(73 56 17 / 16%); color: #fff; font-weight: 600; }

  .catalog__heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 0 0 20px; padding-bottom: 14px; border-bottom: 1px solid rgb(73 56 17 / 10%); }
  .catalog__count { margin: 0; color: #493811; font-size: 15px; font-weight: 600; }
  .catalog__heading label { display: inline-flex; align-items: center; gap: 8px; color: #6a6a6a; font-size: 13.5px; }
  .catalog__heading select {
    padding: 8px 12px;
    border: 1px solid rgb(255 255 255 / 90%);
    border-radius: 9999px;
    background: rgb(255 255 255 / 74%);
    box-shadow: 0 0 0 1px rgb(73 56 17 / 8%);
    color: #222;
    font: inherit;
    font-size: 13.5px;
    font-weight: 500;
  }

  .catalog__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  .catalog__empty {
    max-width: 480px;
    margin: 28px auto 0;
    padding: 28px 24px;
    border: 1px solid rgb(255 255 255 / 92%);
    border-radius: 20px;
    background: linear-gradient(160deg, rgb(255 255 255 / 78%) 0%, rgb(247 245 239 / 64%) 100%);
    box-shadow: 0 12px 32px rgb(73 56 17 / 5%), 0 0 0 1px rgb(73 56 17 / 6%);
    color: #575246;
    text-align: center;
  }
  .catalog__empty[hidden] { display: none; }
  .catalog__empty p { margin: 0 0 12px; }
  .catalog__empty a { color: #493811; font-size: 14px; font-weight: 600; }

  @media (max-width: 1024px) { .catalog__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; } }
  @media (max-width: 780px) { .catalog__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; } }
  @media (max-width: 680px) {
    .catalog { padding: 28px 16px 64px; }
    .catalog__intro { margin-bottom: 20px; }
    .catalog__grid { gap: 12px; }
    .catalog__filter { border-radius: 20px; padding: 8px 10px; }
    .catalog__filter form { grid-template-columns: 1fr 44px; gap: 6px 8px; }
    .catalog__filter label { border-right: 0; padding: 4px 8px; }
    .catalog__filter label:nth-of-type(1) { grid-column: 1; grid-row: 1; border-bottom: 1px solid rgb(73 56 17 / 8%); padding-bottom: 8px; }
    .catalog__filter label:nth-of-type(2) { grid-column: 1 / -1; grid-row: 2; padding-top: 4px; }
    .catalog__filter label:nth-of-type(3) { display: none; }
    .catalog__filter button { grid-column: 2; grid-row: 1; align-self: center; width: 44px; height: 44px; }
    .catalog__tabs { justify-content: flex-start; flex-wrap: nowrap; overflow-x: auto; gap: 8px; margin-bottom: 20px; padding-bottom: 4px; }
    .catalog__heading span { display: none; }
  }
  @media (max-width: 400px) {
    .catalog__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

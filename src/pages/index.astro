---
import SiteLayout from '../layouts/SiteLayout.astro';
import LandCard from '../components/LandCard.astro';
import HeroScroll from '../components/HeroScroll.astro';
import PropertyGuide from '../components/PropertyGuide.astro';
import { lands } from '../data/lands';
const featured = lands.filter((land) => land.unggulan);
---

<SiteLayout title="Beranda">
  <main>
    <HeroScroll />

    <section class="statement">
      <h2>Pilihan tanah untuk berbagai kebutuhan</h2>
      <p>Bandingkan lokasi, luas, harga, dan status tanah. Hubungi admin untuk menanyakan detail atau menjadwalkan survei.</p>
    </section>

    <section class="featured" aria-labelledby="featured-title">
      <div class="section-heading"><h2 id="featured-title">Pilihan tanah <span aria-hidden="true">→</span></h2><a href="/katalog/">Lihat katalog</a></div>
      <div class="featured__row">{featured.map((land) => <LandCard land={land} />)}</div>
    </section>

    <PropertyGuide />

    <section class="faq" id="faq"><h2>Pertanyaan umum</h2><details><summary>Apa perbedaan SHM, HGB, dan AJB?</summary><p>Ketiganya merujuk pada dokumen dengan status hukum berbeda. Minta salinan dokumen dan verifikasi dengan PPAT atau kantor pertanahan sebelum transaksi.</p></details><details><summary>Bisakah saya survei tanah?</summary><p>Bisa. Hubungi admin untuk memastikan bidang masih dapat dikunjungi dan mengatur waktu survei.</p></details><details><summary>Apakah tersedia pembayaran cicilan?</summary><p>Tanyakan pilihan pembayaran kepada admin. Ketentuan dapat berbeda untuk setiap tanah.</p></details></section>

  </main>
</SiteLayout>

<style>
  .statement { max-width: 840px; margin: 0 auto; padding: 96px 24px; text-align: center; }
  .statement h2 { max-width: 760px; margin: 0 auto 24px; font-size: clamp(36px, 5.5vw, 60px); font-weight: 500; line-height: 1.08; text-wrap: balance; }
  .statement p { max-width: 640px; margin: auto; text-align: center; font-size: 17px; line-height: 1.6; }
  .featured { padding: 32px max(24px, calc((100vw - 1280px) / 2)) 64px; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .section-heading h2 { font-size: 22px; font-weight: 500; }
  .section-heading a { color: #222; }
  .featured__row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .faq { max-width: 850px; margin: auto; padding: 20px 24px 100px; }
  .faq h2 { margin: 0 0 24px; font-size: clamp(32px, 4vw, 42px); font-weight: 500; line-height: 1.12; text-align: center; text-wrap: balance; }
  .faq details { max-width: 760px; margin-inline: auto; border-bottom: 1px solid #dedbd2; }
  .faq summary { position: relative; padding: 20px 40px 20px 0; cursor: pointer; font-weight: 500; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 4px; top: 18px; font-size: 20px; font-weight: 400; }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { max-width: 680px; margin: 0 0 20px; color: #6a6a6a; line-height: 1.6; }
  @media (max-width: 780px) {
    .featured__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .faq { padding: 28px 20px 92px; }
  }
</style>
